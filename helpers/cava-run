#!/usr/bin/env bash
# Capture the default speaker monitor, not the microphone.
set -euo pipefail

sink="$(pactl get-default-sink 2>/dev/null || true)"
monitor="auto"
if [[ -n "$sink" ]]; then
  monitor="${sink}.monitor"
  export PULSE_SOURCE="$monitor"
fi

# Private runtime dir (owner-only), not shared /tmp.
confdir="${XDG_RUNTIME_DIR:-$HOME/.cache}/omapandora"
mkdir -p -m 700 "$confdir"
conf="$(mktemp "$confdir/cava.XXXXXX.conf")"

cat >"$conf" <<EOF
[general]
framerate = 60
bars = 56
autosens = 1
sensitivity = 160
lower_cutoff_freq = 30
higher_cutoff_freq = 14000

[input]
method = pulse
source = ${monitor}

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
reverse = 0

[smoothing]
monstercat = 0
waves = 0
gravity = 80
noise_reduction = 22
EOF

# Run cava as a child (not exec) so the config file is removed when the
# visualizer stops, whether cava exits or the shell stops this script.
stdbuf -oL cava -p "$conf" &
child=$!
trap 'kill "$child" 2>/dev/null; rm -f "$conf"' EXIT
trap 'exit 0' INT TERM HUP
wait "$child"
